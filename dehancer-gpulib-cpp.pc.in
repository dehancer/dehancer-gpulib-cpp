prefix=@prefix@
libdir=@libdir@
includedir=@includedir@

Name: dehancer-gpulib-cpp
Description: Dehancer GPU layer SDK (@backend@)
Version: @PROJECT_VERSION@
URL: https://github.com/dehancer/dehancer-gpulib-cpp
Requires: @requires@
Requires.private: @requires_private@
Libs: -L"${libdir}" -l@dehancer_gpu_cpp_lib@
