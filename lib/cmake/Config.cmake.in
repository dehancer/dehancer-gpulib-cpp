@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

foreach(dependency IN ITEMS dehancer_common_cpp dehancer_xmp_cpp dehancer_maths_cpp)
    if(NOT TARGET ${dependency}::${dependency})
        find_dependency(${dependency} CONFIG)
    endif()
endforeach()

find_dependency(Threads)
find_dependency(OpenCV CONFIG)

if(@DEHANCER_GPU_OPENCL@ AND NOT TARGET dehancer_opencl_helper::dehancer_opencl_helper)
    find_dependency(dehancer_opencl_helper CONFIG)
endif()

if(@DEHANCER_GPU_CUDA@)
    find_dependency(CUDAToolkit)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/dehancer_gpulibTargets.cmake")

check_required_components(dehancer_gpulib)
