set (EMBEDDED_OVERLAYS_C_TARGET EmbeddedWatermarks${PROJECT_LIB_PLATFORM_SUFFIX})

file(GLOB CHECK_FILES_PRESENT "${EMBEDDED_IMAGES_DIR}/dehancer_*.c")
if(NOT CHECK_FILES_PRESENT)
    message(STATUS "Running generate.sh to generate source files...")
    execute_process(
        COMMAND bash ${DEHANCER_GPULIB_CPP_SOURCE}/generate.sh ${DEHANCER_GPULIB_CPP_SOURCE}/src/rc ${EMBEDDED_IMAGES_DIR}
        WORKING_DIRECTORY ${DEHANCER_GPULIB_CPP_SOURCE}
        RESULT_VARIABLE GEN_RESULT
    )
    if(NOT GEN_RESULT EQUAL 0)
        message(FATAL_ERROR "generate.sh failed: ${GEN_ERROR}")
    endif()
endif()

file (GLOB EMBEDDED_EMBEDDED_IMAGE_C_FILES
    ${EMBEDDED_IMAGES_DIR}/*.c
)

set_source_files_properties(${EMBEDDED_EMBEDDED_IMAGE_C_FILES} PROPERTIES GENERATED TRUE)

message("EMBEDDED_EMBEDDED_IMAGE_C_FILES ${EMBEDDED_EMBEDDED_IMAGE_C_FILES}")

add_custom_target(
    ${EMBEDDED_OVERLAYS_C_TARGET}
    ALL DEPENDS ${EMBEDDED_EMBEDDED_IMAGE_C_FILES}
    WORKING_DIRECTORY  ${EMBEDDED_IMAGES_DIR}
)
