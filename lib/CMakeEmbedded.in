find_program(
        EMBEDDING_EXEC
        NAMES xxd
        REQUIRED)

if (NOT EMBEDDING_EXEC)
    message(FATAL_ERROR "EMBEDDING_EXEC not found")
else()
    message("EMBEDDING_EXEC ${EMBEDDING_EXEC}")
endif ()

set(
        EMBEDDED_CURRENT_IMAGES_DIR
        "${EMBEDDED_IMAGES_DIR}/${EMBEDDED_CURRENT_C_TARGET}"
)
set(EMBEDDED_OUTPUT_KEYS)
set(EMBEDDED_SYMBOL_KEYS)
set(EMBEDDED_IMAGE_SOURCES)

foreach(image ${EMBEDDED_IMAGE_FILES})

    get_filename_component(fname ${image} NAME_WE)
    get_filename_component(name ${image} NAME)
    get_filename_component(ext ${image} EXT)
    get_filename_component(abs_path ${CMAKE_CURRENT_SOURCE_DIR}/${src} PATH)
    get_filename_component(rel_path ${image} PATH)

    string(TOLOWER "${fname}" output_key)
    string(MAKE_C_IDENTIFIER "dehancer_${fname}" symbol_key)

    list(FIND EMBEDDED_OUTPUT_KEYS "${output_key}" duplicate_index)
    if(NOT duplicate_index EQUAL -1)
        list(GET EMBEDDED_IMAGE_SOURCES ${duplicate_index} duplicate_source)
        message(
                FATAL_ERROR
                "Embedded resources '${duplicate_source}' and '${image}' "
                "have colliding output names '${fname}' in target "
                "'${EMBEDDED_CURRENT_C_TARGET}'"
        )
    endif()

    list(FIND EMBEDDED_SYMBOL_KEYS "${symbol_key}" duplicate_index)
    if(NOT duplicate_index EQUAL -1)
        list(GET EMBEDDED_IMAGE_SOURCES ${duplicate_index} duplicate_source)
        message(
                FATAL_ERROR
                "Embedded resources '${duplicate_source}' and '${image}' "
                "produce the same C identifier '${symbol_key}' in target "
                "'${EMBEDDED_CURRENT_C_TARGET}'"
        )
    endif()

    list(APPEND EMBEDDED_OUTPUT_KEYS "${output_key}")
    list(APPEND EMBEDDED_SYMBOL_KEYS "${symbol_key}")
    list(APPEND EMBEDDED_IMAGE_SOURCES "${image}")

    set(src_file dehancer_${fname})
    set(embedded_file dehancer_${fname}.c)
    set(copied_image ${EMBEDDED_CURRENT_IMAGES_DIR}/${src_file})
    set(embedded_output ${EMBEDDED_CURRENT_IMAGES_DIR}/${embedded_file})

    if(CMAKE_DEBUG_MESSAGE)
        message("IMAGE:  ${embedded_file}   ${fname} ${abs_path} ${rel_path}")
    endif()

    set(embedded_files "")

    add_custom_command(
            OUTPUT "${embedded_output}"
            BYPRODUCTS "${copied_image}"
            COMMAND "${CMAKE_COMMAND}" -E make_directory
                    "${EMBEDDED_CURRENT_IMAGES_DIR}"
            COMMAND "${CMAKE_COMMAND}" -E copy_if_different
                    "${image}"
                    "${copied_image}"
            COMMAND "${CMAKE_COMMAND}" -E chdir
                    "${EMBEDDED_CURRENT_IMAGES_DIR}"
                    "${EMBEDDING_EXEC}" -i "${src_file}" "${embedded_file}"
            DEPENDS "${image}" "${EMBEDDING_EXEC}"
            VERBATIM
            COMMENT "Embed ${name} -> ${embedded_file}"
    )

    list(PREPEND EMBEDDED_EMBEDDED_IMAGE_C_FILES "${embedded_output}")

endforeach()

add_custom_target(
        ${EMBEDDED_CURRENT_C_TARGET}
        ALL
        DEPENDS ${EMBEDDED_EMBEDDED_IMAGE_C_FILES}
)

if(CMAKE_DEBUG_MESSAGE)
    message("EMBEDDED_EMBEDDED_IMAGE_C_FILES ${EMBEDDED_EMBEDDED_IMAGE_C_FILES}")
endif()

set_source_files_properties(${EMBEDDED_EMBEDDED_IMAGE_C_FILES} PROPERTIES GENERATED TRUE)
